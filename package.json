{
  "name": "mexabot-desktop",
  "version": "1.0.0",
  "description": "MEXABOT — Neural Command OS & Despliegue Autónomo de Asistentes Digitales",
  "main": "desktop-main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win --x64",
    "build:www": "node -e \"const fs=require('fs'); fs.mkdirSync('www',{recursive:true}); ['index.html','styles.css','app.js','hero-creation-claw.jpg'].forEach(f=>fs.copyFileSync(f,'www/'+f)); console.log('www synced');\"",
    "build:android": "npm run build:www && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "open:android": "npx cap open android"
  },
  "keywords": [
    "ai",
    "agents",
    "whatsapp",
    "telegram",
    "automation",
    "mexabot"
  ],
  "author": "MEXABOT",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mexabot.desktop",
    "productName": "MexaBot Desktop OS",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "hero-creation-claw.jpg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "hero-creation-claw.jpg",
      "desktop-main.js",
      "desktop-preload.js",
      "desktop-engine.js",
      "SOUL.md"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
